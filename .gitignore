# 依赖与构建产物
node_modules/
.venv/
dist/
build/
out/
*.egg-info/

# 本地上游检出（不入库；目录骨架用 .gitkeep 保住）
repos/*
!repos/.gitkeep

# 本地环境与临时状态
.env
.env.*
!.env.example
.worknexus-tmp/
.worknexus-packed/
.dsh-check/
.superpowers/

# 日志与缓存
*.log
__pycache__/
*.py[cod]
.pytest_cache/

# 公开发布镜像工具与产物（内部，不入库）
.publish/

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
