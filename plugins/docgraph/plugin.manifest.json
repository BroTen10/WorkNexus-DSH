{
  "id": "worknexus.docgraph",
  "name": "DocGraph Adapter",
  "version": "0.1.0",
  "type": "composite",
  "dshCompatibility": ">=0.2.0-rc.1 <0.3.0",
  "hostCoreCompatibility": ">=1.0.0",
  "protected": false,
  "permissions": [
    "space.read",
    "docgraph.submit",
    "docgraph.read"
  ],
  "uiSlots": [
    "worknexus.docgraph.connection",
    "worknexus.docgraph.submit",
    "worknexus.docgraph.jobs"
  ],
  "governance": {
    "source": "local",
    "approval": "required"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
