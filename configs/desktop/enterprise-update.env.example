# WorkNexus-DSH 企业更新源与签名配置模板（T-022）
#
# 用途：把它作为 `repos/deepseek-harness/apps/desktop/.env.windows` 的**唯一来源**。
# 上游 `.gitignore:3` 已忽略 `apps/desktop/.env.windows`，因此本模板入库、真实值只落本地。
#
# 硬约束（T-002 白名单 2.1~2.3 与禁止差异 N-4）：
#   - 只填「更新源地址 / 通道 / 签名输入」；**不得**改动更新算法与强制更新策略。
#   - 通道就用 origin 表达（test / production 两个 origin），不新增通道机制。
#   - 本文件**不得**出现真实证书、PIN、Token、上传凭据；真实值只写进本地 `.env.windows`。
#
# 占位值一律写成 `.invalid` 域名与全 0 的 release id，便于 `--check` 检出「未替换」。

# ── 应用标识（品牌差异集 1.1 的构建期输入，不落代码；取值待 T-021 C-2 决策）──
DSH_DESKTOP_APP_ID=com.worknexus.dsh.invalid

# ── 更新部署选择：test | production（通道 = origin）──
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# test 部署：必须是非空、无路径/凭据/查询/片段的 HTTPS origin
DOWNLOAD_TEST_ORIGIN=https://updates-test.invalid
# test 部署必需：32 位小写十六进制发布批次号（安全随机生成，同一批次内复用以支持重试）
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000

# production 部署：origin 由上游固定为 https://download.deepseek.com，我方**暂不接管**。
# 企业正式域名到位后，需要在差异集评审中决定是否替换该固定 origin（当前登记为 T-022 C-3）。

# ── 强制更新策略源（与更新下载源分离；客户端走 {origin}/api/v0/check_client_update）──
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://policy-test.invalid
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://login-test.invalid"]}

# ── Windows 签名输入（4 个字段由企业构建环境提供；本模板一律留空）──
# 证书类型：EV / OV 代码签名证书（USB token）。未就绪前不得声明「已签名发布」。
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=

# 可选：签名缓存目录与并发（默认 %USERPROFILE%\.dsh-desktop-signing\signature-cache\v1）
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# ── 打包期 npm registry（企业内网镜像；留空 = 上游默认 https://registry.npmjs.org/）──
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# ── 上传通道凭据（仅上传时需要，打包不需要；留空即不启用上传）──
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
