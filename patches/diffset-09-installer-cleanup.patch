diff --git a/apps/desktop/scripts/installer.nsh b/apps/desktop/scripts/installer.nsh
index 5961c071..958bbce8 100644
--- a/apps/desktop/scripts/installer.nsh
+++ b/apps/desktop/scripts/installer.nsh
@@ -8,6 +8,27 @@ ManifestDPIAware true
   !define MUI_CUSTOMFUNCTION_GUIINIT InstallerGuiInit
 !endif
 
+; 企业差异集 09：安装器把自绘窗口用的 window-frame.dll 释放到 $PLUGINSDIR，System 插件会把它一直映射到
+; 进程退出，NSIS 的收尾删除因此失败并静默留下 %TEMP%\nsXXXX.tmp（实测每次安装/卸载各留一个 140 KB 的
+; window-frame.dll）。这里只显式卸载模块并删除该文件——目录留给 NSIS 自己的收尾清理，运行期动 $PLUGINSDIR
+; 的其它内容会破坏尚未完成的 MUI 页面（实测卸载器会中途退出）。删除失败时不排入重启删除，而是交给本进程
+; 退出后的独立清理收尾。
+!macro dshReleaseInstallerUi
+  Push $0
+  ${If} ${FileExists} "$PLUGINSDIR\window-frame.dll"
+    System::Call 'kernel32::GetModuleHandleW(w "$PLUGINSDIR\window-frame.dll") p.r0'
+    ${If} $0 <> 0
+      System::Call 'kernel32::FreeLibrary(p r0)'
+    ${EndIf}
+    ClearErrors
+    Delete "$PLUGINSDIR\window-frame.dll"
+    ${If} ${Errors}
+      ExecShell "open" "$SYSDIR\cmd.exe" "/c ping -n 3 127.0.0.1 >nul & del /f /q $\"$PLUGINSDIR\window-frame.dll$\" & rmdir $\"$PLUGINSDIR$\"" SW_HIDE
+    ${EndIf}
+  ${EndIf}
+  Pop $0
+!macroend
+
 !macro customHeader
   !define /ifndef INSTALLER_STRINGS_FILE "${INSTALLER_SOURCE_DIR}\strings.nsh"
   !include "${INSTALLER_STRINGS_FILE}"
@@ -18,6 +39,10 @@ ManifestDPIAware true
       SetFont /LANG=${LANG_SIMPCHINESE} "Microsoft YaHei UI" 9
     !endif
     !include "${INSTALLER_SOURCE_DIR}\uninstall.nsh"
+    ; 卸载段跑完后释放安装器临时目录（企业差异集 09）。
+    Function un.ReleaseInstallerUi
+      !insertmacro dshReleaseInstallerUi
+    FunctionEnd
   !endif
   !ifndef BUILD_UNINSTALLER
     !include "${INSTALLER_SOURCE_DIR}\theme.nsh"
@@ -89,6 +114,7 @@ ManifestDPIAware true
 
 !macro customUnInstall
   Call un.CleanData
+  Call un.ReleaseInstallerUi
 !macroend
 
 !macro customPageAfterChangeDir
@@ -240,6 +266,10 @@ ManifestDPIAware true
   !insertmacro dshFinishDirectories
   ; Standard uninstall-entry metadata read by inventory tools; the upstream template records it only under its private key.
   WriteRegStr SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" InstallLocation "$INSTDIR"
+  ; 静默安装没有 GUI，.onGUIEnd 不会触发，故在安装段末尾直接释放（企业差异集 09）。
+  ${If} ${Silent}
+    !insertmacro dshReleaseInstallerUi
+  ${EndIf}
   ${If} $0 == 1
     SetErrors
   ${Else}
