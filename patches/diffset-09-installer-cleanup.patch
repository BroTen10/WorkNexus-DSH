diff --git a/apps/desktop/installer/uninstall.nsh b/apps/desktop/installer/uninstall.nsh
index defdd159..6d8c15b7 100644
--- a/apps/desktop/installer/uninstall.nsh
+++ b/apps/desktop/installer/uninstall.nsh
@@ -1,4 +1,5 @@
-; Electron user data and updater downloads leave with the application; the Harness home is never touched.
+; Electron user data and updater downloads leave with the application; the Harness home is only removed when the
+; person uninstalling asks for it (企业差异集 09).
 !include FileFunc.nsh
 Var UnTarget
 Var UnHome
@@ -9,6 +10,45 @@ Function un.RemoveData
   System::Call '$PLUGINSDIR\window-frame.dll::UninstallRemoveData(w "$UnTarget", w "$INSTDIR", w "$UnHome") ?c'
 FunctionEnd
 
+; 企业差异集 09：删除 Harness 主目录时不能把它同时作为受保护根传入——helper 会拒绝删除与受保护根重叠的
+; 路径，而本分支的目标正是主目录本身。故这里单独走一次调用、受保护根留空；调用方已先取得显式同意。
+Function un.RemoveHarnessHome
+  System::Call '$PLUGINSDIR\window-frame.dll::UninstallRemoveData(w "$UnTarget", w "$INSTDIR", w "") ?c'
+FunctionEnd
+
+; A Harness home is only visible here when DSH_HOME is published as a Windows environment variable; the default
+; home is resolved so that it is armed as the protected root even when the variable is absent.
+Function un.ResolveHarnessHome
+  ReadEnvStr $UnHome DSH_HOME
+  ${If} $UnHome == ""
+    StrCpy $UnHome "$PROFILE\.dsh"
+  ${EndIf}
+FunctionEnd
+
+; 企业差异集 09：Harness 主目录的删除必须由调用方显式请求——默认保留（重装/升级后可继续使用），
+; 需要连主目录一起清的部署传 /PURGE_HOME；/KEEP_HOME 可强制覆盖 /PURGE_HOME。
+; 这里刻意不加交互弹窗：上游卸载冒烟用例（tests/windows-uninstall-smoke.ps1 的 interactive 分支）
+; 会在欢迎页之后直接等待卸载完成，任何新增模态框都会让它挂住。
+Function un.PurgeHarnessHome
+  StrCpy $R2 0
+  ${GetParameters} $R0
+  ClearErrors
+  ${GetOptions} $R0 "/KEEP_HOME" $R1
+  ${IfNot} ${Errors}
+    Return
+  ${EndIf}
+  ClearErrors
+  ${GetOptions} $R0 "/PURGE_HOME" $R1
+  ${IfNot} ${Errors}
+    StrCpy $R2 1
+  ${EndIf}
+  ${If} $R2 == 0
+    Return
+  ${EndIf}
+  StrCpy $UnTarget "$UnHome"
+  Call un.RemoveHarnessHome
+FunctionEnd
+
 Function un.CleanData
   ${If} ${isUpdated}
     Return
@@ -20,8 +60,7 @@ Function un.CleanData
   ${IfNot} ${Errors}
     Return
   ${EndIf}
-  ; Only a DSH_HOME published as a Windows environment variable is visible here.
-  ReadEnvStr $UnHome DSH_HOME
+  Call un.ResolveHarnessHome
   ClearErrors
   StrCpy $UnTarget "$APPDATA\${PRODUCT_FILENAME}"
   Call un.RemoveData
@@ -33,4 +72,5 @@ Function un.CleanData
   !endif
   StrCpy $UnTarget "$LOCALAPPDATA\${DSH_UPDATER_CACHE_NAME}"
   Call un.RemoveData
+  Call un.PurgeHarnessHome
 FunctionEnd
