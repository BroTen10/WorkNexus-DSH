diff --git a/apps/desktop/scripts/prepare-cli.ts b/apps/desktop/scripts/prepare-cli.ts
index d2b9e142..a2bc5d26 100644
--- a/apps/desktop/scripts/prepare-cli.ts
+++ b/apps/desktop/scripts/prepare-cli.ts
@@ -1,7 +1,17 @@
 /** Package terminal launch scripts that reuse the installed Electron runtime. */
 
-import { chmodSync, copyFileSync, mkdirSync } from 'node:fs'
+import { chmodSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
 import { join } from 'node:path'
+import { DESKTOP_PRODUCT_NAME } from './desktop-product-name.mjs'
+
+/**
+ * 发行版产品名在 launcher 资产里的占位符（企业差异集 11）。
+ *
+ * launcher 是 shell / cmd 资产，无法 import 产品名常量；因此资产携带占位符，
+ * 由本模块在打包时就地替换成唯一来源 `desktop-product-name.mjs` 的值。
+ * 这样「安装态 CLI 壳指向哪个可执行文件」不会被写死在资产里。
+ */
+const PRODUCT_NAME_TOKEN = '__DSH_DESKTOP_PRODUCT_NAME__'
 
 /**
  * Copy the platform launcher into the application's public command directory.
@@ -12,6 +22,10 @@ export function prepareDesktopCli(destination: string, platform: 'darwin' | 'win
   const name = platform === 'win32' ? 'dsh.cmd' : 'dsh'
   const command = join(destination, 'bin', name)
   mkdirSync(join(destination, 'bin'), { recursive: true })
-  copyFileSync(join(import.meta.dirname, '..', 'cli', name), command)
+  const template = readFileSync(join(import.meta.dirname, '..', 'cli', name), 'utf8')
+  if (!template.includes(PRODUCT_NAME_TOKEN)) {
+    throw new Error(`desktop cli launcher ${name} does not carry ${PRODUCT_NAME_TOKEN}`)
+  }
+  writeFileSync(command, template.replaceAll(PRODUCT_NAME_TOKEN, DESKTOP_PRODUCT_NAME))
   if (platform === 'darwin') chmodSync(command, 0o755)
 }
